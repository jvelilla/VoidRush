<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd"
        name="voidrush"
        uuid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
	<target name="voidrush">
		<root class="VR_APPLICATION" feature="make"/>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="total_order_on_reals" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="scoop"/>
			<void_safety support="all"/>
		</capability>
		<external_include location="$(ISE_PROJECT)/native"/>
		<external_object location="$(ISE_PROJECT)/native/libvr_reactor_bridge.a"/>
		<library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
		<cluster name="voidrush" location="./src" recursive="true"/>
	</target>

	<target name="voidrush_tests" extends="voidrush">
		<root class="VR_TEST_APP" feature="make"/>
	</target>

	<target name="voidrush_example" extends="voidrush">
		<root class="VR_TELEMETRY_APP" feature="make"/>
		<cluster name="example" location="./example/src" recursive="true"/>
	</target>
</system>
